# Copiar a .env (no versionado) y ajustar. Nunca subir .env a Git.
# mibici/config.py lee estas variables con python-dotenv.
MIBICI_TEAM=equipo24
MLFLOW_TRACKING_URI=http://localhost:5001
# MLFLOW_EXPERIMENT=mibici-equipo24

# Nomenclatura de estaciones a descargar. Por defecto nomenclatura_2026_09.csv (la del
# manifiesto); el portal solo publica la vigente, así que si ya no existe usar la actual:
# MIBICI_NOMENCLATURA=nomenclatura_2026_10.csv

# Solo si el servidor de MLflow tiene autenticación (basic-auth). Dejar vacío aquí
# y escribir los valores reales únicamente en tu .env local.
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
