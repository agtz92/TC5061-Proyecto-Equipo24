name: mibici

# Entorno declarado con las mismas versiones fijas de requirements.txt.
python_env: python_env.yaml

# Todos los valores por defecto son "config": el código los toma de mibici/config.py,
# así este archivo no repite rutas, fechas, semillas ni hiperparámetros.
entry_points:
  ingest:
    parameters:
      start: {type: string, default: "config"}
      end: {type: string, default: "config"}
    command: "python -m mibici.dataset --start {start} --end {end}"

  features:
    command: "python -m mibici.features"

  train:
    parameters:
      question: {type: string, default: "p1"}
      model: {type: string, default: "config"}
      n_estimators: {type: string, default: "config"}
      max_depth: {type: string, default: "config"}
      min_samples_leaf: {type: string, default: "config"}
      max_iter: {type: string, default: "config"}
      learning_rate: {type: string, default: "config"}
      alpha: {type: string, default: "config"}
      C: {type: string, default: "config"}
      k: {type: string, default: "config"}
      sample_rows: {type: string, default: "config"}
    command: >-
      python -m mibici.modeling.train run
      --question {question} --model {model}
      --n-estimators {n_estimators} --max-depth {max_depth} --min-samples-leaf {min_samples_leaf}
      --max-iter {max_iter} --learning-rate {learning_rate} --alpha {alpha} --C {C} --k {k}
      --sample-rows {sample_rows}

  # Búsqueda de hiperparámetros con nested runs (rejilla en SEARCH_GRIDS de config.py)
  search:
    parameters:
      question: {type: string, default: "p1"}
      sample_rows: {type: string, default: "config"}
    command: "python -m mibici.modeling.train search --question {question} --sample-rows {sample_rows}"

  baselines:
    command: "python -m mibici.modeling.train baselines"

  # Registra un run en el Model Registry con nombre canónico y linaje completo.
  register:
    parameters:
      question: {type: string, default: "p1"}
      run_id: {type: string}
      alias: {type: string, default: "champion"}
    command: >-
      python -m mibici.modeling.train register
      --question {question} --run-id {run_id} --alias {alias}
