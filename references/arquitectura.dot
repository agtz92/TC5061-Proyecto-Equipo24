digraph G {
  graph [rankdir=LR, fontname="IBM Plex Sans", fontsize=17, nodesep=0.28, ranksep=0.55, pad=0.2, compound=true, bgcolor="white", label="Diagrama realizado con Claude (LLM de Anthropic)", labelloc=b, labeljust=r, fontcolor="#666666"];
  node  [shape=box, style="rounded,filled", fontname="IBM Plex Sans", fontsize=15, color="#4a4a8a", fillcolor="#eef0fb", penwidth=1.2, margin="0.14,0.07"];
  edge  [color="#4a4a8a", penwidth=1.2, arrowsize=0.8, fontname="IBM Plex Sans", fontsize=12, fontcolor="#555555"];

  subgraph cluster_src {
    label="1. Fuentes de datos"; style="rounded,dashed"; labelloc="t"; labeljust="c"; color="#999999"; fontcolor="#333333";
    portal [label="Portal de datos abiertos MiBici\ndatos_abiertos_AAAA_MM.csv\n(2022-01 a 2026-09, 57 archivos)"];
    nom    [label="nomenclatura_2026_09.csv\n(id, nombre, lat, lon, capacidad)"];
    ext    [label="Externas\nfestivos y calendario SEP\nclima horario (Open-Meteo)", fillcolor="#f5f5f5", color="#888888"];
  }

  subgraph cluster_ing {
    label="2. Ingesta reproducible"; style="rounded,dashed"; labelloc="t"; labeljust="c"; color="#999999"; fontcolor="#333333";
    dataset [label="dataset.py (CLI)\nrequests: descarga\ndetección UTF-8 / Latin-1\nmapeo de columnas por año\ntipado de fechas\nvalidación de esquema"];
  }

  subgraph cluster_sto {
    label="3. Almacenamiento (data/ excluido de Git; solo el manifiesto se versiona)"; style="rounded,dashed"; labelloc="t"; labeljust="c"; color="#999999"; fontcolor="#333333";
    raw     [label="data/raw/\nCSV originales"];
    interim [label="data/interim/\nParquet por año y mes\n(pyarrow)"];
    proc    [label="data/processed/\ntablas estación × hora\nperfiles por estación"];
    manif   [label="data_manifest.json\nregistros + hash SHA-256\n(versionado en Git)", fillcolor="#fff6e0", color="#b07a00"];
  }

  subgraph cluster_proc {
    label="4. Procesamiento"; style="rounded,dashed"; labelloc="t"; labeljust="c"; color="#999999"; fontcolor="#333333";
    feat [label="features.py\nagregación estación × hora\nrezagos 24 h / 168 h\ncalendario, flujo neto,\nseñales de censura, perfiles\n(pandas + DuckDB)"];
  }

  subgraph cluster_train {
    label="5. Entrenamiento y evaluación"; style="rounded,dashed"; labelloc="t"; labeljust="c"; color="#999999"; fontcolor="#333333";
    mlproject [label="MLproject\nentry points p1, p2, p3\n(mlflow run)", fillcolor="#e6f4ea", color="#2e7d32"];
    train [label="modeling/train.py\nP1 LightGBM Poisson\nP2 LightGBM clasificador\nP3 K-Means / Ward / GMM\nbaselines incluidos"];
    evalm [label="evaluación temporal\nback-test por origen\nmétricas test_*\nreports/figures/"];
  }

  subgraph cluster_reg {
    label="6. Registro de experimentos"; style="rounded,dashed"; labelloc="t"; labeljust="c"; color="#999999"; fontcolor="#333333";
    mlflow [label="MLflow Tracking Server\n(local, backend SQLite\n+ mlartifacts/)", fillcolor="#e6f4ea", color="#2e7d32"];
    registry [label="MLflow Model Registry\nmodelos candidatos\npor pregunta", fillcolor="#e6f4ea", color="#2e7d32"];
  }

  subgraph cluster_code {
    label="Código y colaboración"; style="rounded,dashed"; labelloc="t"; labeljust="c"; color="#999999"; fontcolor="#333333";
    gh  [label="GitHub\nCookiecutter Data Science\nGitHub Flow + Pull Requests", fillcolor="#f0f0f0", color="#555555"];
    cfg [label="config.py\nrutas, fechas, semillas\nrequirements.txt fijado", fillcolor="#f0f0f0", color="#555555"];
  }

  portal -> dataset; nom -> dataset; ext -> dataset;
  dataset -> raw; raw -> interim [label="normaliza"]; dataset -> manif [label="hash"];
  interim -> feat; feat -> proc [constraint=false];
  proc -> train [constraint=false];
  gh -> mlproject [style=invis]; cfg -> mlproject [style=invis]; mlproject -> train; train -> evalm;
  evalm -> mlflow [label="params, métricas,\nartefactos"];
  manif -> mlflow [label="tag data_version", style=dashed, constraint=false];
  gh -> mlflow [label="tag git_commit", style=dashed];
  mlflow -> registry;
  cfg -> dataset [style=dotted, arrowhead=none];
  cfg -> train [style=dotted, arrowhead=none];
}
